# Required for /contact to actually send email (app/api/contact/route.ts).
# Get a key at https://resend.com/api-keys — add the real value to
# .env.local for local dev, and to the project's env vars in Vercel for
# production. Never commit the real key.
RESEND_API_KEY=

# Optional overrides — sensible defaults are baked into the route handler.
# CONTACT_TO_EMAIL defaults to business@paulmandele.co (lib/constants.ts).
# CONTACT_FROM_EMAIL defaults to Resend's sandbox sender, which only
# delivers to the Resend account's own email until a domain is verified.
# Once paulmandele.co is verified in Resend, set this to a real address
# on that domain (e.g. "Paul Mandele <hello@paulmandele.co>").
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
